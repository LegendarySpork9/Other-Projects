@page "/"
@layout Layout.MainLayout

<PageTitle>Home</PageTitle>

<div style="@GetStyle()">
    @if (Servers.Count != 0)
    {
        @foreach (var server in Servers)
        {
            <div class="server-block">
                <div class="server-header">
                    <h1>@server.HostName</h1>
                    <p>@server.Game @server.GameVersion</p>
                </div>
                <div class="status-row">
                    <div class="status-item">
                        <div class="status-image-wrapper">
                            <img src="/Images/Login Background.png" />
                        </div>
                        <label>PC Status: <span class="@server.Statuses[0].StatusClass">@server.Statuses[0].Status</span></label>
                    </div>
                    <div class="status-item">
                        <div class="status-image-wrapper">
                            <img src="/Images/Game Icon.png" />
                        </div>
                        <label>Server Status: <span class="@server.Statuses[1].StatusClass">@server.Statuses[1].Status</span></label>
                    </div>
                    <div class="status-item">
                        <div class="status-image-wrapper">
                            <img src="/Images/Connection Icon.png" />
                        </div>
                        <label>Connection Status: <span class="@server.Statuses[2].StatusClass">@server.Statuses[2].Status</span></label>
                    </div>
                </div>
            </div>
        }
    }

    else
    {
        <p class="no-servers-message">No active servers registered in API. If this is wrong, please speak with an administrator.</p>
    }
</div>