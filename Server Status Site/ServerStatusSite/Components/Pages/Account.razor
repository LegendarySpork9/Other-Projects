@page "/account"

<PageTitle>Account</PageTitle>

<div class="container">
    <center class="@GetStyle("Form")">
        <img src="/Images/Account Icon.png" height="100" width="100" />
        <br />
        <br />
        <div style="display: flex; gap: 41px;">
            <label>Username:</label>
            <input type="text" style="@GetStyle("Input")" @bind="Username" />
        </div>
        <br />
        <div style="display: flex; gap: 44px;">
            <label>Password:</label>
            <input type="password" style="@GetStyle("Input")" @bind ="Password" />
        </div>
        <br />
        <div style="display: flex; gap: 13px;">
            <label>Discord Name:</label>
            <input type="text" style="@GetStyle("Input")" @bind ="DiscordName" />
        </div>
        <br />
        <div style="display: flex; gap: 33px; align-items: center;">
            <label>Dark Mode:</label>
            <label class="switch">
                <input type="checkbox" @bind="DarkMode">
                <span class="slider round"></span>
            </label>
        </div>
        <br />
        <button class="btn btn-primary" @onclick="SaveClick">Save</button>
    </center>
</div>