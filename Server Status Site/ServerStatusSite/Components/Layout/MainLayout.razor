@inherits LayoutComponentBase

<HeadOutlet />

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main style="@GetStyle("Body")">
        <div style="@GetStyle("Bar")" class="top-row px-4">
            <NavLink style="@GetStyle("Link")" class="nav-link" href="account">
                Account
            </NavLink>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>